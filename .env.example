# 숙박숙박 환경 변수 목록 (SAD 4.5)
# 이 파일에는 이름만 적고 값은 비워 둔다. 실제 값은 .env.local(커밋 금지)과
# Vercel 환경 변수, GitHub Actions Secrets에만 넣는다.
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저에 노출되므로 원래 공개용인 키만 쓴다.

# 앱
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용
SUPABASE_JWT_SECRET=              # 서버 전용 (Access Token 서명)

# 카카오
KAKAO_REST_API_KEY=               # 서버 전용
KAKAO_CLIENT_SECRET=              # 서버 전용
KAKAO_ADMIN_KEY=                  # 서버 전용 (탈퇴 시 연결 끊기)
NEXT_PUBLIC_KAKAO_JS_KEY=         # 공개용, 카카오 콘솔에서 허용 도메인 제한

# 메일
RESEND_API_KEY=                   # 서버 전용
MAIL_FROM=

# 푸시 (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=            # 서버 전용
FIREBASE_PRIVATE_KEY=             # 서버 전용
# 웹 푸시용 Firebase 웹 설정 (공개용, 화면에 들어감)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=   # 웹 푸시 공개 키

# OCR (채팅 사진 계좌번호 검사)
GOOGLE_VISION_API_KEY=            # 서버 전용

# 해시·내부 작업
IDENTIFIER_HASH_SECRET=           # 서버 전용
EMAIL_CODE_HASH_SECRET=           # 서버 전용
CRON_SECRET=                      # 서버 전용

# 오류 추적
SENTRY_DSN=
